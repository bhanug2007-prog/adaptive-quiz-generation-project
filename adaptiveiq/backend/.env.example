# AdaptiveIQ backend settings. Copy to .env and edit. Every value can also be an environment variable.

# development | production (production refuses unsafe values)
ENVIRONMENT=development

# Database. PostgreSQL is the normal choice. For a quick local try without PostgreSQL you can use
#   DATABASE_URL=sqlite:///./adaptiveiq.db
# /api/health always shows which database is active. Production refuses SQLite.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/adaptiveiq

# Sessions. Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
SESSION_HOURS=8
# true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Accounts
# empty = lecturer sign-up turned off. Never share it publicly.
LECTURER_INVITE_CODE=
# empty = any email; or e.g. iiitdwd.ac.in,gmail.com
ALLOWED_EMAIL_DOMAINS=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
INVITE_MAX_FAILURES=5

# Email verification. Without SMTP the link is printed in this backend's console (development only).
REQUIRE_EMAIL_VERIFICATION=true
VERIFY_LINK_HOURS=48
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Question-generation model: any OpenAI-compatible endpoint (llama.cpp llama-server on the laptop).
MODEL_BASE_URL=http://127.0.0.1:8080
# only for a hosted server; stays on the backend, never sent to the browser
MODEL_API_KEY=
MODEL_NAME=qwen7b-mcq
# finetuned | base (base adds two worked examples to the prompt)
MODEL_VARIANT=finetuned
MODEL_BASE_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_ADAPTER=qwen-7b-mcq-adapter (LoRA r=16), merged
MODEL_QUANTIZATION=GGUF Q4_K_M
MODEL_TIMEOUT_S=600
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=320

# Generation pipeline
DEFAULT_BRANCH=CSE
MAX_ATTEMPTS_PER_QUESTION=3
MATH_CHECK=true
MATH_CHECK_STRICT=false
# The check runs model-written Python. On Windows (no OS memory/CPU limits) it is skipped unless this is
# true; numeric questions are then left to the lecturer's review. In Docker or Linux every layer applies.
MATH_CHECK_ALLOW_WITHOUT_OS_LIMITS=false
DUPLICATE_THRESHOLD=0.85
MAX_QUEUED_GENERATIONS=10
MAX_REFERENCE_CHARS=12000

# Adaptive engine (see docs/ML_EVALUATION.md)
MASTERY_MIN_EVIDENCE=5
MASTERY_HALF_LIFE_DAYS=21

# Frontend address (used in email links and allowed as a request origin)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Forms export (optional; see docs/GOOGLE_FORMS.md). Leave empty until you have an OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
