# AdaptiveIQ backend settings. Copy to .env and edit. Every value can also be an environment variable.

# development | production (production refuses unsafe values)
ENVIRONMENT=development

# Database. PostgreSQL is the normal choice. For a quick local try without PostgreSQL you can use
#   DATABASE_URL=sqlite:///./adaptiveiq.db
# /api/health always shows which database is active. Production refuses SQLite.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/adaptiveiq

# Sessions. Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
SESSION_HOURS=8
# true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Accounts
# empty = lecturer sign-up turned off. Never share it publicly.
LECTURER_INVITE_CODE=
# empty = any email; or e.g. iiitdwd.ac.in,gmail.com
ALLOWED_EMAIL_DOMAINS=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
INVITE_MAX_FAILURES=5
RESET_TOKEN_MINUTES=15
RESET_REQUEST_MAX=5
RESET_IP_MAX=20
RESET_VERIFY_MAX=10
RESET_WINDOW_MINUTES=15

# Email verification. Without SMTP the link is printed in this backend's console (development only).
REQUIRE_EMAIL_VERIFICATION=true
VERIFY_LINK_HOURS=48
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Question-generation model: any OpenAI-compatible endpoint (llama.cpp llama-server on the laptop).
MODEL_BASE_URL=http://127.0.0.1:8080
# only for a hosted server; stays on the backend, never sent to the browser
MODEL_API_KEY=
MODEL_NAME=qwen7b-mcq
# finetuned | base (base adds two worked examples to the prompt)
MODEL_VARIANT=finetuned
MODEL_BASE_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_ADAPTER=qwen-7b-mcq-adapter (LoRA r=16), merged
MODEL_QUANTIZATION=GGUF Q4_K_M
MODEL_TIMEOUT_S=600
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=320

# Generation pipeline
DEFAULT_BRANCH=CSE
MAX_ATTEMPTS_PER_QUESTION=3
MATH_CHECK=true
MATH_CHECK_STRICT=true
# Simple calculations run in a restricted AST expression parser; multi-step Python uses an isolated
# worker with OS memory/CPU/process limits (setrlimit on Linux/macOS, Job Object on Windows). Set this
# to true only on unsupported platforms without OS limits.
MATH_CHECK_ALLOW_WITHOUT_OS_LIMITS=false
DUPLICATE_THRESHOLD=0.85
MAX_QUEUED_GENERATIONS=10
MAX_REFERENCE_CHARS=12000

# AI question reviewer (optional). Grok checks each lecturer question after the Python checks:
# correctness, topic, difficulty, options, ambiguity and explanation. Leave GROK_API_KEY empty to use the
# Python checks only; the app works the same and marks questions "AI review not done".
# The key stays on the backend. Only the question, its options, answer, explanation, topic and the source
# passage are sent to Grok, never student data.
QUALITY_CHECK=true
QUALITY_CHECK_PRACTICE=false
QUALITY_CHECK_DIFFICULTY=true
QUALITY_MIN_SCORE=60
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# use a model name your xAI account lists
GROK_MODEL=grok-4.3
GROK_TIMEOUT_S=45
GROK_COOLDOWN_S=300

# Lecturer Insights Agent ("Ask about your class" in Class Analytics).
# With a Grok key, Grok picks which read-only analytics tools to run and words the answer; students are
# sent as "Student 1", "Student 2"... (never names or emails). Without a key it answers from fixed rules.
INSIGHTS_AI=true
INSIGHTS_PER_10_MIN=20

# Assessment integrity monitoring (each quiz switches it on in its settings; see docs/MONITORING.md).
# Only events are stored (page hidden, no face, speech-like sound...), never video or audio.
MONITORING_RETENTION_DAYS=180
MONITORING_FACE_INTERVAL_MS=1500

# Adaptive engine (see docs/ML_EVALUATION.md)
MASTERY_MIN_EVIDENCE=5
MASTERY_HALF_LIFE_DAYS=21

# Frontend address (used in email links and allowed as a request origin)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Forms export (optional; see docs/GOOGLE_FORMS.md). Leave empty until you have an OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
